NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://claims:claims_dev_password@localhost:5432/claims
CORS_ORIGINS=http://localhost:5173

FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: not used while photos are stored on local disk.
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Where evidence photos are saved (relative to apps/api). Keep it out of Git.
EVIDENCE_DIR=./data/evidence
# Local only: path to a service-account key kept OUTSIDE the repo.
# On Google Cloud hosting, use the attached service account instead.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/serviceAccount.json

# Set true in staging/production so the API also verifies Firebase App Check tokens.
APPCHECK_ENFORCE=false
