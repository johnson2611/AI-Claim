{
  "name": "ai-insurance-claims-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted motor-insurance first-notice-of-loss workspace using Firebase AI Logic hybrid inference (BuildHybridAI 2026).",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:web": "npm run dev -w @claims/web",
    "dev:api": "npm run dev -w @claims/api",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:migrate -w @claims/api",
    "db:seed": "npm run seed -w @claims/api --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
